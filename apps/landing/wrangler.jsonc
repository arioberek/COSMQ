{
	"name": "cosmq",
	"compatibility_date": "2026-01-05", // Update to the day you deploy
	"assets": {
		"directory": "./dist",
		// Serve dist/404.html for unknown paths instead of a bare 404.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
